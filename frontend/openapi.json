                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "The process runs and answers.",
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Logdock can take data: the database answers, there is free space, and no\nwriter has stalled.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role",
          "locale",
          "disabled",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "email": {
            "type": "string",
            "description": "Also the sign-in name."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "locale": {
            "type": "string",
            "description": "`en` or `de`."
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          }
        }
      },
      "AccountRole": {
        "type": "string",
        "enum": [
          "admin",
          "member"
        ]
      },
      "AddEnvironmentRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "at",
          "action",
          "outcome"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string"
          },
          "client_ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "outcome": {
            "type": "string",
            "description": "`success`, `failure` or `denied`."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "required": [
          "email",
          "name",
          "role",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          }
        },
        "additionalProperties": false
      },
      "CreateKeyRequest": {
        "type": "object",
        "required": [
          "environment_id"
        ],
        "properties": {
          "environment_id": {
            "type": "integer",
            "format": "int64"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Its first stages, e.g. `[\"production\", \"staging\"]`."
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreatedKey": {
        "type": "object",
        "required": [
          "key",
          "secret",
          "dsn"
        ],
        "properties": {
          "dsn": {
            "type": "string",
            "description": "The DSN for the Sentry SDK: `SENTRY_LARAVEL_DSN`."
          },
          "key": {
            "$ref": "#/components/schemas/Key"
          },
          "secret": {
            "type": "string",
            "description": "The key itself, shown this once."
          }
        }
      },
      "Environment": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What keeps Logdock from taking data: `database_unavailable`,\n`low_disk`, `writer_stalled`."
          },
          "status": {
            "type": "string",
            "description": "`live`, `ready` or `not_ready`."
          }
        }
      },
      "IngestCount": {
        "type": "object",
        "required": [
          "day",
          "accepted",
          "skipped",
          "rejected"
        ],
        "properties": {
          "accepted": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "day": {
            "type": "string",
            "description": "`YYYY-MM-DD` in UTC."
          },
          "key_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The key that was used; `null` for requests no key let in."
          },
          "last_rejection": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LastRejection"
              },
              {
                "type": "null"
              }
            ]
          },
          "rejected": {
            "type": "object",
            "description": "Refused items by reason: `auth`, `environment`, `size`, `rate`,\n`invalid`, `disk`, `overloaded`.",
            "additionalProperties": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "skipped": {
            "type": "integer",
            "format": "int64",
            "description": "Items of kinds Logdock does not keep.",
            "minimum": 0
          }
        }
      },
      "Key": {
        "type": "object",
        "required": [
          "id",
          "environment_id",
          "prefix",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "environment_id": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string",
            "description": "The key's first characters."
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LastRejection": {
        "type": "object",
        "required": [
          "reason",
          "detail",
          "at"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PasswordRequest": {
        "type": "object",
        "required": [
          "current",
          "new"
        ],
        "properties": {
          "current": {
            "type": "string"
          },
          "new": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "description": "Error body as defined by RFC 9457 (`application/problem+json`).",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable identifier the frontend relies on, e.g. `not_found`."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation, if there is more to say than the title."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Reason phrase of the status code."
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`; `code` identifies the problem."
          }
        }
      },
      "ProfileRequest": {
        "type": "object",
        "properties": {
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "`en` or `de`."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "environments",
          "settings",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "environments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Environment"
            }
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          }
        }
      },
      "Redaction": {
        "type": "object",
        "properties": {
          "allowed_keys": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "When set, only these attribute keys are kept; `user.*` keeps a prefix."
          },
          "extra_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "More key fragments whose values are never stored, beyond the built-in\nones (password, token, secret, …)."
          },
          "scrub_emails": {
            "type": "boolean"
          },
          "scrub_ip_addresses": {
            "type": "boolean"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "required": [
          "account",
          "csrf_token",
          "expires_at"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "csrf_token": {
            "type": "string",
            "description": "Sent back in `X-CSRF-Token` with every request that changes something."
          },
          "expires_at": {
            "type": "string",
            "description": "When the session ends unless used before."
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "notify",
          "notify_new_issues",
          "notify_regressions",
          "notify_monitors",
          "redaction"
        ],
        "properties": {
          "notify": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Who gets e-mail about the project's errors, also people without an\naccount."
          },
          "notify_monitors": {
            "type": "boolean"
          },
          "notify_new_issues": {
            "type": "boolean"
          },
          "notify_regressions": {
            "type": "boolean"
          },
          "redaction": {
            "$ref": "#/components/schemas/Redaction"
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "code",
          "email",
          "name",
          "password"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The code Logdock wrote to its log at the start."
          },
          "email": {
            "type": "string"
          },
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "needed"
        ],
        "properties": {
          "needed": {
            "type": "boolean",
            "description": "No account exists yet: the first administrator is to be created with\nthe setup code from Logdock's log."
          }
        }
      },
      "UpdateAccountRequest": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccountRole"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "UpdateProjectRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "settings": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Settings"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-logdock_session",
        "description": "Set by sign-in or setup. Named `logdock_session` where secure cookies are off."
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health, version and storage"
    },
    {
      "name": "auth",
      "description": "The first setup, sign-in, the session and the caller's own account"
    },
    {
      "name": "accounts",
      "description": "Accounts and the audit log, for administrators"
    },
    {
      "name": "projects",
      "description": "Projects, their stages, ingest keys, settings and ingest counts"
    }
  ]
}
