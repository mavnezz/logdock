{
  "openapi": "3.1.0",
  "info": {
    "title": "Logdock API",
    "description": "API of Logdock's web interface.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "The process runs and answers.",
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Logdock can take data: the database answers, there is free space, and no\nwriter has stalled.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What keeps Logdock from taking data: `database_unavailable`,\n`low_disk`, `writer_stalled`."
          },
          "status": {
            "type": "string",
            "description": "`live`, `ready` or `not_ready`."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health, version and storage"
    }
  ]
}
