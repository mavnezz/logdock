# Logdock's configuration (docs/architecture.md, 2.4). Copy to .env and
# adjust; every value below is the default unless it says otherwise.

# --- Docker Compose ----------------------------------------------------------

# Host port the container is published on, on all the host's addresses.
# LOGDOCK_BIND=127.0.0.1 limits it to a reverse proxy on the same host.
LOGDOCK_PORT=8080
#LOGDOCK_BIND=127.0.0.1
# The data directory on the host, owned by PUID:PGID.
LOGDOCK_DATA=./data
PUID=1000
PGID=1000

# --- Network -----------------------------------------------------------------

# The address the interface is reached at (no default), for the DSNs shown
# in the interface. https:// (or none) turns on secure cookies, which
# browsers keep over HTTPS only: reached directly over plain HTTP, set the
# http:// address, e.g. http://docker-host:8080, or sign-in is refused.
LOGDOCK_PUBLIC_URL=https://logdock.example.com
# Proxies (CIDR, comma-separated) whose X-Forwarded-For is believed. Empty:
# none. For a proxy in another container, its Docker network, e.g.
# 172.16.0.0/12.
LOGDOCK_TRUSTED_PROXIES=
# Secure cookies follow LOGDOCK_PUBLIC_URL; set false only for plain HTTP.
#LOGDOCK_SECURE_COOKIES=true

# --- Retention and storage ---------------------------------------------------

LOGDOCK_RETENTION_LOGS_DAYS=30
LOGDOCK_RETENTION_EVENTS_DAYS=90
LOGDOCK_RETENTION_TRACES_DAYS=7
# Counts per minute (charts, monitoring), kept longer than what they count.
LOGDOCK_RETENTION_ROLLUPS_DAYS=90
# All data together; above this the oldest days are deleted first.
LOGDOCK_MAX_STORAGE=50GiB
# Below this much free space ingest answers 503 and readiness fails.
LOGDOCK_MIN_FREE_DISK=2GiB

# --- Ingest ------------------------------------------------------------------

# A request body as sent, and after decompression.
LOGDOCK_INGEST_MAX_BODY=1MiB
LOGDOCK_INGEST_MAX_DECOMPRESSED=20MiB
# Items per second and key, and how many a key may send at once.
LOGDOCK_INGEST_RATE=1000
LOGDOCK_INGEST_BURST=5000
# Log entries waiting for the writer at most; beyond, ingest answers 429/503.
LOGDOCK_INGEST_QUEUE=100000

# --- Accounts ----------------------------------------------------------------

# A session ends after this long without a request, and after its lifetime.
LOGDOCK_SESSION_IDLE=12h
LOGDOCK_SESSION_LIFETIME=7d
# The first setup asks for a code Logdock writes to its log at a start
# without accounts. Set one here instead for automated setups.
#LOGDOCK_SETUP_CODE=

# --- E-mail ------------------------------------------------------------------

# The SMTP server for notifications about new and returning issues, with its
# credentials. Without it, Logdock sends no e-mail. smtp:// uses STARTTLS when
# the server offers it (add ?tls=required to insist); smtps:// is TLS from the
# start, usually on port 465. Characters such as @ in the password must be
# percent-encoded.
#LOGDOCK_SMTP_URL=smtp://user:password@mail.example.com:587
# The sender of that e-mail.
LOGDOCK_MAIL_FROM=Logdock <logdock@localhost>

# --- Process -----------------------------------------------------------------

# Time to finish queued writes on SIGTERM.
LOGDOCK_SHUTDOWN_TIMEOUT=20s
# A tracing filter, e.g. info or logdock_infra=debug,info.
LOGDOCK_LOG_LEVEL=info
# json (for Docker) or text.
LOGDOCK_LOG_FORMAT=json
